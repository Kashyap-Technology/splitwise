# Absolute base URL of the Django API, including the /api prefix.
# Local:  http://localhost:8000/api
# Prod:   https://<api-host>/api
#
# The VITE_ prefix is mandatory — Vite only exposes prefixed variables to the
# client bundle. Naming this API_URL instead leaves import.meta.env.VITE_API_URL
# undefined at runtime.
VITE_API_URL=http://localhost:8000/api
